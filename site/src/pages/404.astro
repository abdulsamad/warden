---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found - Warden" description="This page doesn't exist." path="/404" noindex>
  <div class="hero not-found">
    <div class="container">
      <header class="site-header">
        <a class="brand" href="/">
          <img src="/favicon.svg" width="36" height="36" alt="" />
          Warden
        </a>
      </header>
      <main class="not-found-body">
        <h1>Page not found</h1>
        <p class="hero-lead">This page doesn't exist. The app, setup and download are on the home page.</p>
        <div class="cta">
          <a class="btn btn-light" href="/">Go to the home page</a>
        </div>
      </main>
    </div>
  </div>
</Base>

<style>
  .not-found {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .not-found-body {
    padding-block: clamp(3rem, 12vw, 8rem);
  }
</style>
