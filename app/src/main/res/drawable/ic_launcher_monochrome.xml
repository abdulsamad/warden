<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ themed icon: same mark as a single-color silhouette; the launcher applies the tint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path
            android:fillColor="#000000"
            android:fillType="evenOdd"
            android:pathData="@string/warden_mark_path" />
    </group>
</vector>
