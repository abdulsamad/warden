*.aab
*.ap_
/app/release/
/dist/

# Heap dumps and JVM crash logs
*.hprof
hs_err_pid*.log
replay_pid*.log

# Signing secrets: never commit. The release keystore lives in ~/.android/keystores/warden/.
*.jks
*.keystore
*.p12
keystore.properties
signing.env

# OS
.DS_Store

# Local AI and code-navigation tooling (per machine)
/.claude/
/.serena/
/graphify-out/
